# The ClusterFuzzLite image copies the checkout. Build output and local fuzz
# artifacts stay out of it; `.git` stays in, so build.sh can fetch the pinned
# Brotli submodule when the checkout left it empty.
**/target
fuzz/afl/seeds
fuzz/afl/findings
fuzz/afl/artifacts
# Lean's package cache (Mathlib's build, several GB) is local only.
verification/lean/.lake
